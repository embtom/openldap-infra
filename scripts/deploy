#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPOSITORY_DIR="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"

HOST=""
TAG=""
RECREATE_DATA=false
RECREATE_ALL=false
VAULT_FILE="${REPOSITORY_DIR}/ansible/inventories/group_vars/all/vault.yml"

usage() {
  cat <<EOF
Usage: $0 [--host HOST] [--tag TAG] [--recreate-data] [--recreate-all]

  -H, --host HOST   Deploy to a remote host over SSH (default: localhost)
  -t, --tag TAG     Run only the specified Ansible tag
      --recreate-data
                     Delete and recreate the OpenLDAP database during deploy
      --recreate-all
             Delete and recreate OpenLDAP data, configuration, and schemas
      --help        Show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -H | --host)
    HOST="${2:?Missing host value}"
    shift 2
    ;;
  -t | --tag)
    TAG="${2:?Missing tag value}"
    shift 2
    ;;
  --recreate-data)
    RECREATE_DATA=true
    shift
    ;;
  --recreate-all)
    RECREATE_ALL=true
    shift
    ;;
  --help)
    usage
    exit 0
    ;;
  *)
    TAG="$1"
    shift
    ;;
  esac
done

case "${HOST}" in
"" | localhost | 127.0.0.1 | ::1)
  LIMIT=(--limit localhost)
  HOST_ARGS=()
  ;;
*)
  LIMIT=(--limit remote)
  HOST_ARGS=(--extra-vars "ansible_host=${HOST}")
  ;;
esac

TAG_ARGS=()
if [[ -n "${TAG}" ]]; then
  TAG_ARGS=(--tags "${TAG}")
fi

if [[ ! -f "${VAULT_FILE}" ]]; then
  echo "ERROR: LDAP secrets vault '${VAULT_FILE}' does not exist." >&2
  echo "Run 'python3 ${REPOSITORY_DIR}/scripts/configure-openldap.py' first." >&2
  exit 1
fi

EXTRA_VARS=()
if [[ "${RECREATE_DATA}" == true ]]; then
  EXTRA_VARS+=(--extra-vars "openldap_service_data_recreate=true")
fi
if [[ "${RECREATE_ALL}" == true ]]; then
  EXTRA_VARS+=(--extra-vars "openldap_service_full_recreate=true")
fi

(
  cd "${SCRIPT_DIR}/../ansible"
  ansible-playbook \
    --inventory inventories/hosts.yml \
    playbooks/openldap_setup.yml \
    --ask-become-pass \
    --ask-vault-pass \
    "${LIMIT[@]}" \
    "${HOST_ARGS[@]}" \
    "${EXTRA_VARS[@]}" \
    "${TAG_ARGS[@]}"
)
