#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPOSITORY_DIR="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"

HOST=""
VAULT_FILE="${REPOSITORY_DIR}/ansible/inventories/group_vars/all/vault.yml"

usage() {
  cat <<EOF
Usage: $0 [--host HOST]

  -H, --host HOST   Configure an SSSD client over SSH (default: localhost)
      --help        Show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -H | --host)
    HOST="${2:?Missing host value}"
    shift 2
    ;;
  --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 1
    ;;
  esac
done

case "${HOST}" in
"" | localhost | 127.0.0.1 | ::1)
  LIMIT=(--limit localhost)
  HOST_ARGS=()
  ;;
*)
  LIMIT=(--limit remote)
  HOST_ARGS=(--extra-vars "ansible_host=${HOST}")
  ;;
esac

if [[ ! -f "${VAULT_FILE}" ]]; then
  echo "ERROR: LDAP secrets vault '${VAULT_FILE}' does not exist." >&2
  echo "Run 'python3 ${REPOSITORY_DIR}/scripts/configure-openldap.py' first." >&2
  exit 1
fi

(
  cd "${REPOSITORY_DIR}/ansible"
  ansible-playbook \
    --inventory inventories/hosts.yml \
    playbooks/sssd_client_setup.yml \
    --ask-become-pass \
    --ask-vault-pass \
    "${LIMIT[@]}" \
    "${HOST_ARGS[@]}"
)
