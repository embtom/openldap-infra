#!/usr/bin/env bash
set -euo pipefail

LDAP_HOST="$(hostname --fqdn 2>/dev/null || hostname)"
LDAP_PROTOCOL="ldaps"
LDAP_PORT=""
LDAP_BASE_DN="dc=example,dc=org"
LDAP_CA_CERT="${HOME}/.local/share/embtom/pki/certs/root-ca.crt"

usage() {
  cat <<EOF
Usage: $0 [--host HOST] [--protocol ldap|ldaps] [--port PORT] [--base-dn BASE_DN] [--ca-cert PATH]

  -H, --host HOST             LDAP host to test (default: local FQDN)
  -P, --protocol PROTOCOL     ldap or ldaps (default: ldaps)
  -p, --port PORT             Port (default: 389 for ldap, 636 for ldaps)
  -b, --base-dn BASE_DN       LDAP base DN (default: dc=example,dc=org)
  -c, --ca-cert PATH          Root CA certificate for ldaps
                                (default: $LDAP_CA_CERT)
      --help                   Show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -H | --host)
    LDAP_HOST="${2:?Missing host value}"
    shift 2
    ;;
  -P | --protocol)
    LDAP_PROTOCOL="${2:?Missing protocol value}"
    shift 2
    ;;
  -p | --port)
    LDAP_PORT="${2:?Missing port value}"
    shift 2
    ;;
  -b | --base-dn)
    LDAP_BASE_DN="${2:?Missing base DN value}"
    shift 2
    ;;
  -c | --ca-cert)
    LDAP_CA_CERT="${2:?Missing CA certificate path}"
    shift 2
    ;;
  --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 1
    ;;
  esac
done

LDAP_ADMIN_DN="cn=admin,${LDAP_BASE_DN}"

case "$LDAP_PROTOCOL" in
ldap)
  LDAP_PORT="${LDAP_PORT:-389}"
  ;;
ldaps)
  LDAP_PORT="${LDAP_PORT:-636}"
  if [[ ! -f "$LDAP_CA_CERT" ]]; then
    echo "ERROR: Root CA certificate '$LDAP_CA_CERT' does not exist." >&2
    exit 1
  fi
  ;;
*)
  echo "ERROR: Protocol must be 'ldap' or 'ldaps', not '$LDAP_PROTOCOL'." >&2
  exit 1
  ;;
esac

echo "==> Querying LDAP directory at ${LDAP_PROTOCOL}://${LDAP_HOST}:${LDAP_PORT}"
if [[ "$LDAP_PROTOCOL" == "ldaps" ]]; then
  LDAPTLS_CACERT="$LDAP_CA_CERT" LDAPTLS_REQCERT=demand \
    ldapsearch -x -LLL -H "${LDAP_PROTOCOL}://${LDAP_HOST}:${LDAP_PORT}" \
    -D "$LDAP_ADMIN_DN" -W -b "$LDAP_BASE_DN"
else
  ldapsearch -x -LLL -H "${LDAP_PROTOCOL}://${LDAP_HOST}:${LDAP_PORT}" \
    -D "$LDAP_ADMIN_DN" -W -b "$LDAP_BASE_DN"
fi
