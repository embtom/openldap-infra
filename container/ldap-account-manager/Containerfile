FROM debian:trixie-slim

# Renovate updates the release and its Debian package checksum together.
ARG LAM_VERSION=9.7
ARG LAM_SHA256=eb4f652d97e63ba295cbec536e4bc4b9eb150d752503189eefd50ffeff6825bb

ENV DEBIAN_FRONTEND=noninteractive

COPY container/ldap-account-manager/trixie-backports.sources /etc/apt/sources.list.d/trixie-backports.sources

# PHP-FPM needs systemd-tmpfiles, not the systemd service manager.
RUN apt-get update \
  && apt-get upgrade --yes \
  && apt-get install --no-install-recommends --yes \
  ca-certificates \
  curl \
  locales \
  nginx \
  php-fpm \
  systemd-standalone-tmpfiles \
  && curl -fsSL --retry 3 -o /tmp/lam.deb \
  "https://github.com/LDAPAccountManager/lam/releases/download/${LAM_VERSION}/ldap-account-manager_${LAM_VERSION}-1_all.deb" \
  && echo "${LAM_SHA256}  /tmp/lam.deb" | sha256sum --check --status \
  && apt-get install --no-install-recommends --yes /tmp/lam.deb \
  && apt-get install --no-install-recommends --yes -t trixie-backports libcurl4t64 \
  && rm -f /tmp/lam.deb \
  && apt-get purge --yes --auto-remove curl \
  && sed -i 's/^# \(en_GB.UTF-8 UTF-8\)/\1/' /etc/locale.gen \
  && locale-gen \
  && rm -rf /var/lib/apt/lists/*

COPY container/ldap-account-manager/entrypoint.sh /usr/local/bin/ldap-account-manager-entrypoint
COPY container/ldap-account-manager/bootstrap-profile.php /usr/local/bin/ldap-account-manager-bootstrap-profile
COPY container/ldap-account-manager/groupOfNames.inc /usr/share/ldap-account-manager/lib/modules/groupOfNames.inc
COPY container/ldap-account-manager/nginx.conf /etc/nginx/sites-available/default

# Configure the container entrypoints and use the supplied Nginx virtual host.
RUN chmod 0755 /usr/local/bin/ldap-account-manager-entrypoint \
  && chmod 0755 /usr/local/bin/ldap-account-manager-bootstrap-profile \
  && rm -f /etc/nginx/sites-enabled/default \
  && ln -s /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default

# Create the paths which are mounted as persistent container volumes.
RUN mkdir -p /var/lib/ldap-account-manager/config \
  /var/lib/ldap-account-manager/data/sess \
  /var/lib/ldap-account-manager/data/tmp/internal

# Preserve package defaults as seeds for an initially empty config volume.
RUN cp -L /etc/ldap-account-manager/config.cfg \
  /usr/local/share/ldap-account-manager-config.cfg \
  && cp /var/lib/ldap-account-manager/config/language \
  /usr/local/share/ldap-account-manager-language \
  && cp /var/lib/ldap-account-manager/config/lam.conf \
  /usr/local/share/ldap-account-manager-profile.conf \
  && cp -a /var/lib/ldap-account-manager/config/templates \
  /usr/local/share/ldap-account-manager-templates

# Redirect package paths to data that survives container replacement.
RUN rm -f /etc/ldap-account-manager/config.cfg \
  /var/lib/ldap-account-manager/config/config.cfg \
  && ln -s /var/lib/ldap-account-manager/config/config.cfg \
  /etc/ldap-account-manager/config.cfg \
  && rm -f /usr/share/ldap-account-manager/sess \
  /usr/share/ldap-account-manager/tmp \
  && ln -s /var/lib/ldap-account-manager/data/sess \
  /usr/share/ldap-account-manager/sess \
  && ln -s /var/lib/ldap-account-manager/data/tmp \
  /usr/share/ldap-account-manager/tmp

EXPOSE 443

ENTRYPOINT ["/usr/local/bin/ldap-account-manager-entrypoint"]
