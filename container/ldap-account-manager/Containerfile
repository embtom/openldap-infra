FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install --no-install-recommends --yes \
  ldap-account-manager \
  nginx \
  php-fpm \
  && rm -rf /var/lib/apt/lists/*

COPY container/ldap-account-manager/entrypoint.sh /usr/local/bin/ldap-account-manager-entrypoint
COPY container/ldap-account-manager/bootstrap-profile.php /usr/local/bin/ldap-account-manager-bootstrap-profile
COPY container/ldap-account-manager/nginx.conf /etc/nginx/sites-available/default

RUN chmod 0755 /usr/local/bin/ldap-account-manager-entrypoint \
  && chmod 0755 /usr/local/bin/ldap-account-manager-bootstrap-profile \
  && rm -f /etc/nginx/sites-enabled/default \
  && ln -s /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default \
  && mkdir -p /var/lib/ldap-account-manager/config \
  /var/lib/ldap-account-manager/data/sess \
  /var/lib/ldap-account-manager/data/tmp/internal \
  && cp -L /etc/ldap-account-manager/config.cfg \
  /usr/local/share/ldap-account-manager-config.cfg \
  && rm -f /etc/ldap-account-manager/config.cfg \
  && rm -f /var/lib/ldap-account-manager/config/config.cfg \
  && cp /var/lib/ldap-account-manager/config/lam.conf \
  /usr/local/share/ldap-account-manager-profile.conf \
  && ln -s /var/lib/ldap-account-manager/config/config.cfg \
  /etc/ldap-account-manager/config.cfg \
  && rm -f /usr/share/ldap-account-manager/sess \
  /usr/share/ldap-account-manager/tmp \
  && ln -s /var/lib/ldap-account-manager/data/sess \
  /usr/share/ldap-account-manager/sess \
  && ln -s /var/lib/ldap-account-manager/data/tmp \
  /usr/share/ldap-account-manager/tmp

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/ldap-account-manager-entrypoint"]
