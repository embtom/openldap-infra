FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install --no-install-recommends --yes ca-certificates \
  ldap-utils \
  procps \
  slapd \
  && rm -rf /var/lib/apt/lists/*

COPY container/openldap/entrypoint.sh /usr/local/bin/openldap-entrypoint

RUN chmod 0755 /usr/local/bin/openldap-entrypoint \
  && mkdir -p /var/lib/ldap /run/slapd \
  && rm -rf /var/lib/ldap/

VOLUME ["/var/lib/ldap"]

EXPOSE 389 636

ENTRYPOINT ["/usr/local/bin/openldap-entrypoint"]
