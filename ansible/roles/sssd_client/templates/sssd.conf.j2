[sssd]
config_file_version = 2
debug_level = 0
services = nss, pam
domains = LDAP

[domain/LDAP]
id_provider = ldap
auth_provider = ldap
ldap_uri = {{ sssd_client_ldap_uri }}
ldap_search_base = {{ sssd_client_search_base }}
ldap_default_bind_dn = {{ sssd_client_bind_dn }}
ldap_default_authtok_type = password
ldap_default_authtok = {{ sssd_client_bind_password }}
ldap_tls_reqcert = demand
ldap_tls_cacert = {{ sssd_client_ca_certificate }}
cache_credentials = true
enumerate = false
